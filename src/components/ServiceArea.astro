---
import Icon from "./Icon.astro";
---

<section class="section area">
  <div class="container area-grid">
    <div class="area-copy" data-reveal>
      <p class="eyebrow">Where We Operate</p>
      <h2 class="h2">Nairobi & Surrounding Areas</h2>
      <p class="area-lede">
        We provide scheduled home and workplace sample collection within our
        service area.
      </p>
      <p class="area-body">
        Need a location outside our regular coverage?
      </p>
      <p class="area-body">
        Contact us and we will confirm availability.
      </p>
      <a class="btn btn-primary" href="#booking">
        Check Availability
        <Icon class="icon-arrow" name="arrow-right" size={18} />
      </a>
    </div>

    <div class="area-visual" data-reveal style="--reveal-delay:140ms" aria-hidden="true">
      <svg viewBox="0 0 420 300" role="img" aria-label="Abstract skyline illustration of Nairobi">
        <defs>
          <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ece6da"/>
            <stop offset="1" stop-color="#f7f6f2"/>
          </linearGradient>
        </defs>
        <rect width="420" height="300" rx="24" fill="url(#sky)"/>
        <circle cx="310" cy="86" r="34" fill="#8c3b44" opacity="0.14"/>
        <path d="M30 210 L70 138 L108 210 Z" fill="#ffffff" opacity="0.85"/>
        <rect x="120" y="170" width="52" height="40" fill="#ffffff" opacity="0.85"/>
        <path d="M172 210 L210 118 L250 210 Z" fill="#dcd2be"/>
        <rect x="262" y="150" width="64" height="60" fill="#ffffff" opacity="0.9"/>
        <rect x="340" y="180" width="44" height="30" fill="#dcd2be"/>
        <rect y="210" width="420" height="90" rx="0" fill="#f7f6f2" opacity="0.6"/>
        <circle cx="86" cy="196" r="14" fill="none" stroke="#8c3b44" stroke-width="1.5" opacity="0.5"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .area {
    background: var(--color-surface);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .area-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
  }

  .area-copy h2 {
    margin-top: 1.1rem;
    margin-bottom: 1.2rem;
  }

  .area-lede {
    color: var(--color-ink-2);
    margin-bottom: 1.4rem;
    max-width: 30rem;
  }

  .area-body {
    color: var(--color-ink);
    max-width: 30rem;
  }

  .area-body + .area-body {
    margin-bottom: 1.8rem;
  }

  .area-visual svg {
    width: 100%;
    height: auto;
    border-radius: var(--radius-l);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-soft);
  }

  @media (max-width: 860px) {
    .area-grid {
      grid-template-columns: 1fr;
    }
    .area-visual {
      max-width: 460px;
    }
  }
</style>