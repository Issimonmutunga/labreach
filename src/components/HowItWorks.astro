---
const steps = [
  {
    num: "01",
    label: "BOOK",
    copy: "Send us a WhatsApp message, call us or complete our booking form.",
  },
  {
    num: "02",
    label: "SCHEDULE",
    copy: "Choose your preferred date, time and location.",
  },
  {
    num: "03",
    label: "WE COME TO YOU",
    copy: "A qualified professional arrives at your location for collection.",
  },
  {
    num: "04",
    label: "SPECIMEN HANDLING",
    copy: "Your specimen is identified, labelled and handled for transport to the designated laboratory.",
  },
  {
    num: "05",
    label: "RESULTS",
    copy: "The designated laboratory processes the specimen and releases results through its reporting channels.",
  },
];
---

<section class="section how" id="how-it-works">
  <div class="container">
    <div class="how-head" data-reveal>
      <p class="eyebrow">A Simple Process</p>
      <h2 class="h2">How It Works</h2>
    </div>

    <ol class="how-grid">
      {steps.map((s, i) => (
        <li class="step-card" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <span class="step-num">{s.num}</span>
          <div class="step-body">
            <span class="step-label">{s.label}</span>
            <p class="step-copy">{s.copy}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how {
    background: var(--color-surface);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .how-head {
    max-width: 40rem;
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .how-head h2 {
    margin-top: 1.1rem;
  }

  .how-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 18px;
  }

  .step-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.5rem 1.4rem 1.7rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-m);
    background: var(--color-bg);
    transition: border-color var(--dur-med) var(--ease-out),
      box-shadow var(--dur-med) var(--ease-out),
      transform var(--dur-med) var(--ease-out);
  }

  .step-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-soft);
    transform: translateY(-3px);
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: 0.95rem;
    font-weight: 650;
    letter-spacing: 0.05em;
    font-variant-numeric: tabular-nums;
  }

  .step-label {
    display: block;
    font-size: 0.88rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
    margin-bottom: 0.45rem;
  }

  .step-copy {
    color: var(--color-ink-2);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  @media (max-width: 1100px) {
    .how-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .how-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .how-grid {
      grid-template-columns: 1fr;
    }
  }
</style>