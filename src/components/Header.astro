---
import { site, whatsappLink, WHATSAPP_MESSAGE } from "../config/site";
import Icon from "./Icon.astro";

const nav = [
  { label: "Services", href: "#services" },
  { label: "How It Works", href: "#how-it-works" },
  { label: "About", href: "#about" },
  { label: "FAQ", href: "#faq" },
];

const whatsappHref = whatsappLink(WHATSAPP_MESSAGE);
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a class="brand" href="#top" aria-label={`${site.brandName} — home`}>
      <span class="brand-mark" aria-hidden="true">
        <Icon name="droplet" size={18} strokeWidth={1.6} />
      </span>
      <span class="brand-name">{site.brandName}</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      {whatsappHref && (
        <a class="header-whatsapp" href={whatsappHref} target="_blank" rel="noopener">
          <Icon name="message-circle" size={17} strokeWidth={1.7} />
          <span>WhatsApp</span>
        </a>
      )}
      <a class="btn btn-primary btn-header" href="#booking">
        Book a Visit
      </a>
      <button
        class="nav-toggle"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </div>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile">
    <ul>
      {nav.map((item) => (
        <li><a href={item.href}><span>{item.label}</span><Icon name="arrow-up-right" size={16} /></a></li>
      ))}
      <li class="mobile-contact">
        <a class="btn btn-primary btn-block" href="#booking">
          Book a Visit
        </a>
        {whatsappHref && (
          <a class="btn btn-secondary btn-block" href={whatsappHref} target="_blank" rel="noopener">
            <Icon name="message-circle" size={17} /> Chat on WhatsApp
          </a>
        )}
      </li>
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector(".site-header");
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");

  const syncHeader = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 24);
  };

  const closeMenu = () => {
    toggle?.setAttribute("aria-expanded", "false");
    header?.classList.remove("menu-open");
    document.body.classList.remove("menu-locked");
  };

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    header?.classList.toggle("menu-open", !open);
    document.body.classList.toggle("menu-locked", !open);
  });

  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
  window.addEventListener("resize", () => {
    if (window.innerWidth > 900) closeMenu();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });

  syncHeader();
  window.addEventListener("scroll", syncHeader, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    transition: background-color var(--dur-med) var(--ease-out),
      border-color var(--dur-med) var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  .site-header.is-scrolled {
    background: rgba(247, 246, 242, 0.82);
    -webkit-backdrop-filter: saturate(1.4) blur(16px);
    backdrop-filter: saturate(1.4) blur(16px);
    border-bottom-color: var(--color-line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 650;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--color-accent);
    color: var(--color-surface);
    box-shadow: 0 4px 10px -4px rgba(140, 59, 68, 0.5);
  }

  .nav-desktop ul {
    display: flex;
    list-style: none;
    gap: 2.2rem;
    margin: 0;
    padding: 0;
  }

  .nav-desktop a {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-ink-2);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .nav-desktop a:hover {
    color: var(--color-ink);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .header-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.95rem;
    font-weight: 550;
    color: var(--color-accent);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .header-whatsapp:hover {
    color: var(--color-accent-deep);
  }

  .btn-header {
    min-height: 44px;
    padding: 0.6rem 1.4rem;
    font-size: 0.95rem;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    align-items: center;
  }

  .nav-toggle-bar {
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-ink);
    transition: transform var(--dur-med) var(--ease-out), opacity var(--dur-med);
  }

  .menu-open .nav-toggle-bar:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .menu-open .nav-toggle-bar:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--color-bg);
    padding: 1rem 20px 2.5rem;
    display: none;
    overflow-y: auto;
    border-top: 1px solid var(--color-line);
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 0;
  }

  .mobile-menu li a:not(.btn) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.05rem 0.25rem;
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
  }

  .mobile-contact {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.5rem;
  }

  .btn-block {
    width: 100%;
  }

  body.menu-locked {
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .nav-desktop,
    .header-whatsapp {
      display: none;
    }
    .nav-toggle {
      display: flex;
      margin-left: 4px;
    }
    .site-header.menu-open .mobile-menu {
      display: block;
    }
  }

  @media (min-width: 901px) {
    .mobile-menu {
      display: none !important;
    }
  }

  @media (max-width: 480px) {
    .header-whatsapp {
      display: none;
    }
    .btn-header {
      padding: 0.6rem 1.1rem;
      font-size: 0.9rem;
    }
  }
</style>