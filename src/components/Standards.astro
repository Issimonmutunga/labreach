---
import Icon from "./Icon.astro";

const standards = [
  "Proper patient identification",
  "Appropriate specimen collection",
  "Infection-prevention practices",
  "Correct specimen labelling",
  "Appropriate specimen handling",
  "Safe specimen transportation",
  "Patient privacy and confidentiality",
  "Professional client communication",
];
---

<section class="section standards">
  <div class="container">
    <div class="standards-head" data-reveal>
      <p class="eyebrow">Precision & Process Discipline</p>
      <h2 class="h2">Our Professional Standards</h2>
    </div>

    <ol class="standards-list">
      {standards.map((s, i) => (
        <li class="standard" data-reveal style={`--reveal-delay:${i * 40}ms`}>
          <span class="standard-num">
            {String(i + 1).padStart(2, "0")}
          </span>
          <span class="standard-label">{s}</span>
          <span class="standard-mark" aria-hidden="true">
            <Icon name="check" size={15} strokeWidth={2} />
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .standards-head {
    max-width: 40rem;
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  .standards-head h2 {
    margin-top: 1.1rem;
  }

  .standards-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--color-line-strong);
  }

  .standard {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.4rem 0.5rem;
    border-bottom: 1px solid var(--color-line);
    transition: padding-left var(--dur-med) var(--ease-out), background-color var(--dur-med) var(--ease-out);
  }

  .standard:hover {
    padding-left: 1rem;
    background: rgba(255, 255, 255, 0.4);
  }

  .standard:nth-child(odd) {
    padding-right: 2rem;
  }

  .standard-num {
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    min-width: 2.2rem;
  }

  .standard-label {
    font-size: clamp(1.02rem, 1.4vw, 1.2rem);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .standard-mark {
    margin-left: auto;
    align-self: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--color-line);
    color: var(--color-ink-3);
    transition: background-color var(--dur-med) var(--ease-out), color var(--dur-med) var(--ease-out), border-color var(--dur-med) var(--ease-out);
  }

  .standard:hover .standard-mark {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-surface);
  }

  @media (max-width: 768px) {
    .standards-list {
      grid-template-columns: 1fr;
    }
    .standard {
      align-items: center;
    }
    .standard:nth-child(odd) {
      padding-right: 0.5rem;
    }
  }
</style>