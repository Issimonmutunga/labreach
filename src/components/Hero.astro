---
import { site, whatsappLink, WHATSAPP_MESSAGE } from "../config/site";
import Icon from "./Icon.astro";

const whatsappHref = whatsappLink(WHATSAPP_MESSAGE);

const trust = [
  { icon: "shield-check" as const, label: "Professional Collection" },
  { icon: "lock-keyhole" as const, label: "Patient Privacy" },
  { icon: "droplet" as const, label: "Quality-Focused Handling" },
  { icon: "map-pin" as const, label: "Nairobi & Surrounding Areas" },
];
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow" data-reveal>{site.brandName}</p>
      <h1 class="display hero-title" data-reveal style="--reveal-delay:80ms">
        Skip the Queue.<br />
        <span class="accent">We Come to You.</span>
      </h1>
      <p class="hero-support" data-reveal style="--reveal-delay:160ms">
        Professional Laboratory Sample Collection — At Your Doorstep
      </p>
      <p class="lede hero-desc" data-reveal style="--reveal-delay:240ms">
        Professional blood and laboratory specimen collection from the comfort of
        your home, office, hotel, or preferred location.
      </p>
      <p class="hero-desc hero-desc--2" data-reveal style="--reveal-delay:320ms">
        Led by an experienced medical laboratory professional, our service is
        designed to make laboratory sample collection convenient, professional,
        confidential and patient-centred.
      </p>

      <div class="hero-actions" data-reveal style="--reveal-delay:400ms">
        <a class="btn btn-primary" href="#booking">
          Book a Home Visit
          <Icon class="icon-arrow" name="arrow-right" size={18} />
        </a>
        {whatsappHref ? (
          <a
            class="btn btn-secondary"
            href={whatsappHref}
            target="_blank"
            rel="noopener"
          >
            <Icon name="message-circle" size={18} />
            Chat on WhatsApp
          </a>
        ) : (
          <span class="btn btn-secondary btn--disabled" aria-disabled="true">
            <Icon name="message-circle" size={18} />
            Chat on WhatsApp
          </span>
        )}
      </div>
    </div>

    <div class="hero-media" data-reveal style="--reveal-delay:200ms">
      <div class="hero-photo">
        <img
          src={site.heroImage}
          alt="Artistic placeholder for a professional phlebotomist collecting a specimen at a client's home"
          width="800"
          height="1000"
          fetchpriority="high"
        />
        <div class="hero-photo-tag" aria-hidden="true">
          <Icon name="map-pin" size={14} />
          Nairobi, Kenya
        </div>
      </div>
    </div>
  </div>

  <div class="container trust-row" data-reveal>
    <div class="trust-item">
      <span class="trust-icon"><Icon name={trust[0].icon} size={18} /></span>
      <span>{trust[0].label}</span>
    </div>
    <div class="trust-item">
      <span class="trust-icon"><Icon name={trust[1].icon} size={18} /></span>
      <span>{trust[1].label}</span>
    </div>
    <div class="trust-item">
      <span class="trust-icon"><Icon name={trust[2].icon} size={18} /></span>
      <span>{trust[2].label}</span>
    </div>
    <div class="trust-item">
      <span class="trust-icon"><Icon name={trust[3].icon} size={18} /></span>
      <span>{trust[3].label}</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(40px, 7vh, 88px);
    padding-bottom: clamp(48px, 6vw, 84px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(40px, 5vw, 88px);
    align-items: center;
  }

  .hero-copy {
    max-width: 46rem;
  }

  .hero-eyebrow {
    margin-bottom: 1.4rem;
  }

  .hero-title {
    margin-bottom: 1.6rem;
  }

  .hero-title .accent {
    color: var(--color-accent);
  }

  .hero-support {
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.35;
    margin-bottom: 1.6rem;
    color: var(--color-ink);
  }

  .hero-desc {
    max-width: 34rem;
  }

  .hero-desc--2 {
    margin-top: 0.9rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.2rem;
  }

  .hero-media {
    position: relative;
  }

  .hero-photo {
    position: relative;
    border-radius: var(--radius-l);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
    aspect-ratio: 4 / 5;
    border: 1px solid var(--color-line);
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-photo-tag {
    position: absolute;
    left: 18px;
    bottom: 18px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-pill);
    background: rgba(247, 246, 242, 0.86);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    font-size: 0.82rem;
    font-weight: 550;
    letter-spacing: 0.02em;
    color: var(--color-ink);
    border: 1px solid rgba(23, 23, 23, 0.08);
  }

  .trust-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(56px, 8vw, 96px);
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-line);
    gap: 1.25rem;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.95rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .trust-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    color: var(--color-accent);
    box-shadow: 0 1px 2px rgba(23, 23, 23, 0.04);
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-media {
      max-width: 560px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: 32px;
    }
    .trust-row {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 1.25rem;
    }
    .hero-actions .btn {
      width: 100%;
    }
  }

  @media (max-width: 380px) {
    .trust-row {
      grid-template-columns: 1fr;
    }
  }
</style>