---
import { site } from "../config/site";
import Icon from "./Icon.astro";

const links = [
  { label: "Services", href: "#services" },
  { label: "How It Works", href: "#how-it-works" },
  { label: "About", href: "#about" },
  { label: "FAQ", href: "#faq" },
  { label: "Book a Visit", href: "#booking" },
];
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="footer-logo" href="#top">
        <span class="brand-mark" aria-hidden="true">
          <Icon name="droplet" size={16} strokeWidth={1.6} />
        </span>
        <span class="footer-brand-name">{site.brandName}</span>
      </a>
      <p class="footer-tagline">Professional Laboratory Sample Collection</p>
      <p class="footer-location">
        <Icon name="map-pin" size={15} />
        {site.location}
      </p>
    </div>

    <nav class="footer-col" aria-label="Footer">
      <ul>
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-col footer-contact">
      <p class="footer-label">Reach Us</p>
      <p>
        <Icon name="phone" size={15} />
        <span>{site.phone}</span>
      </p>
      <p>
        <Icon name="mail" size={15} />
        <span>{site.email}</span>
      </p>
      <p>
        <Icon name="message-circle" size={15} />
        <span>{site.whatsapp}</span>
      </p>
    </div>
  </div>

  <div class="container footer-bottom">
    <p class="footer-copy">© 2026 <span class="brand-inline">{site.brandName}</span>. All Rights Reserved.</p>
    <p class="footer-copy">
      <a href="/important-information" class="footer-legal">Important Information</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-line);
    padding-top: clamp(56px, 8vw, 88px);
    padding-bottom: 40px;
    color: var(--color-ink);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr;
    gap: clamp(28px, 5vw, 72px);
    padding-bottom: 3rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
  }

  .footer-brand-name {
    font-family: var(--font-brand);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--color-accent);
    color: var(--color-surface);
  }

  .footer-tagline {
    color: var(--color-ink-2);
    max-width: 22rem;
    margin-bottom: 1.1rem;
  }

  .footer-location {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.9rem;
    color: var(--color-ink-2);
  }

  .footer-location :global(.icon) {
    color: var(--color-accent);
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .footer-col a {
    color: var(--color-ink-2);
    font-weight: 500;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer-col a:hover {
    color: var(--color-ink);
  }

  .footer-label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin-bottom: 0.9rem;
  }

  .footer-contact {
    display: grid;
    align-content: start;
  }

  .footer-contact p {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.92rem;
    color: var(--color-ink-2);
    margin-bottom: 0.55rem;
  }

  .footer-contact :global(.icon) {
    color: var(--color-accent);
    flex: none;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-line);
    padding-top: 1.5rem;
    margin-top: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-copy {
    font-size: 0.88rem;
    color: var(--color-ink-3);
  }

  .brand-inline {
    font-family: var(--font-brand);
    font-weight: 500;
    color: var(--color-ink-2);
  }

  .footer-legal {
    color: var(--color-ink-3);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer-legal:hover {
    color: var(--color-ink);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
</style>