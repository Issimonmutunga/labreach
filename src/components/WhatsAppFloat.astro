---
import { whatsappLink, WHATSAPP_MESSAGE } from "../config/site";
import Icon from "./Icon.astro";

const href = whatsappLink(WHATSAPP_MESSAGE);
---

{href && (
  <a
    class="whatsapp-float"
    href={href}
    target="_blank"
    rel="noopener"
    aria-label="Chat with LabReach on WhatsApp about home sample collection"
  >
    <Icon name="message-circle" size={22} />
  </a>
)}

<style>
  .whatsapp-float {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 90;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-surface);
    box-shadow: 0 12px 28px -10px rgba(110, 43, 52, 0.55),
      0 2px 6px rgba(23, 23, 23, 0.1);
    transition: transform var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .whatsapp-float:hover {
    transform: translateY(-2px) scale(1.03);
    background: var(--color-accent-deep);
  }

  @media (min-width: 900px) {
    .whatsapp-float {
      right: 28px;
      bottom: 28px;
    }
  }
</style>