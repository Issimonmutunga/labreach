---
import Icon from "./Icon.astro";

const benefits = [
  {
    icon: "clock" as const,
    title: "Convenience",
    copy: "Laboratory sample collection without unnecessary travel.",
  },
  {
    icon: "shield-check" as const,
    title: "Professional Service",
    copy: "Collection performed by qualified medical laboratory professionals.",
  },
  {
    icon: "lock-keyhole" as const,
    title: "Privacy",
    copy: "Your personal information and laboratory information are handled confidentially.",
  },
  {
    icon: "timer" as const,
    title: "Time Saving",
    copy: "Book a scheduled visit around your daily routine.",
  },
  {
    icon: "droplet" as const,
    title: "Quality Focus",
    copy: "We recognise that accurate laboratory testing begins with proper specimen collection and handling.",
  },
  {
    icon: "hand-heart" as const,
    title: "Patient-Centred",
    copy: "We aim to provide a respectful, comfortable and professional collection experience.",
  },
];
---

<section class="section why">
  <div class="container">
    <div class="why-head" data-reveal>
      <p class="eyebrow">Why LabReach</p>
      <h2 class="h2">Designed Around Your Time.</h2>
    </div>

    <ul class="benefits">
      {benefits.map((b, i) => (
        <li class="benefit" data-reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
          <span class="benefit-icon"><Icon name={b.icon} size={22} strokeWidth={1.5} /></span>
          <h3 class="benefit-title">{b.title}</h3>
          <p class="benefit-copy">{b.copy}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why-head {
    max-width: 40rem;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .why-head h2 {
    margin-top: 1.1rem;
  }

  .benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .benefit {
    padding: clamp(26px, 3vw, 40px);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-soft);
    transition: transform var(--dur-med) var(--ease-out), box-shadow var(--dur-med) var(--ease-out), border-color var(--dur-med) var(--ease-out);
  }

  .benefit:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
    border-color: var(--color-line-strong);
  }

  .benefit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border-radius: 14px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    margin-bottom: 1.4rem;
  }

  .benefit-title {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin-bottom: 0.55rem;
  }

  .benefit-copy {
    color: var(--color-ink-2);
    font-size: 0.97rem;
    line-height: 1.65;
  }

  @media (max-width: 1024px) {
    .benefits {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .benefits {
      grid-template-columns: 1fr;
    }
  }
</style>